# Copie para .env e ajuste os valores: cp .env.example .env

# Usadas pelo docker-compose (serviço db)
POSTGRES_USER=postgres
POSTGRES_DB=telehubbi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Usadas pela API (config.py). Host localhost porque a API roda fora do Compose.
DATABASE_URL=postgresql+asyncpg://postgres:troque-esta-senha@localhost:5432/telehubbi
DATABASE_URL_TESTE=postgresql+asyncpg://postgres:troque-esta-senha@localhost:5432/telehubbi_teste

# Opcionais (valores padrão do config.py)
# CORS_ORIGINS=["http://localhost:5173"]
# TOLERANCIA_FUTURO_S=5
# LIMITE_LEITURAS_CRUAS=1000
# JANELA_MAXIMA_CONSULTA_H=72
